#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
    echo "Usage: $(basename "$0") <port>" >&2
    exit 1
fi

pids=$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t || true)

if [ -z "$pids" ]; then
    echo "No process listening on port $1" >&2
    exit 1
fi

# shellcheck disable=SC2086
kill $pids
